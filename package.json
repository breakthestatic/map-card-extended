{
  "name": "map-card-extended",
  "version": "0.1.1",
  "description": "Home Assistant's built-in map card plus per-entity tap actions",
  "main": "src/index.js",
  "scripts": {
    "build": "rollup -c --bundleConfigAsCjs",
    "watch": "rollup -c --watch --bundleConfigAsCjs",
